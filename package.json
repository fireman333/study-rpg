{
  "name": "study-rpg",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source gamified study RPG engine. Default content pack: Taiwan Stage-1 medical board exam (一階醫師國考).",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @study-rpg/neurons-tw dev",
    "dev:neurons": "pnpm --filter @study-rpg/neurons-tw dev",
    "build": "pnpm -r build",
    "build:neurons": "pnpm --filter @study-rpg/neurons-tw build",
    "build:neurons-content": "pnpm --filter @study-rpg/content-neurons-tw build",
    "build:cf": "VITE_DEPLOY_BASE=/neurons/ VITE_SYNC_WORKER_URL=https://api.med-study-rpg.com pnpm --filter @study-rpg/neurons-tw build && node scripts/build-cf-pages-dist.mjs",
    "deploy:cf": "pnpm run build:cf && wrangler pages deploy dist-cf --project-name med-study-rpg --branch main --commit-dirty=true",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:dexie-fixtures": "BASE_REF=origin/main HEAD_REF=HEAD bash scripts/lint-dexie-fixtures.sh",
    "gen-status": "node scripts/gen-status.mjs",
    "reconcile": "tsx scripts/reconcile.ts",
    "bulk-migrate": "tsx scripts/bulk-migrate.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "aws4fetch": "^1.0.20",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
