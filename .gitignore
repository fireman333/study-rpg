# build artifacts
packages/content-medexam-tw/dist/questions.json
apps/*/dist
dist-cf

# sprite rollback backups (temporary, removed after change verification)
packages/theme-pixel-medical/sprites.v1-backup/

# codex imagegen intermediate alpha PNGs (working artifacts)
packages/theme-pixel-medical/tmp/

# Python bytecode cache (offline content scripts, e.g. render-backfill-pages.py)
__pycache__/

# local-only dev dashboard (regenerate via `pnpm gen-status`)
docs/status.html

# Claude Code session worktrees (ephemeral, per-session)
.claude/worktrees/

# Supabase CLI runtime state (pooler URL / project ref cache / version pins — per-machine)
supabase/.temp/

# codex CLI scratch image output (fallback workdir when running from project root)
output/

# session-bus cross-session message queue (ephemeral, per-worktree; session-bus skill)
.claude-msgs/

# openspec-to-notion skill: generated plan + per-project secret env (never commit)
.openspec-notion.plan.json
.openspec-notion.env

# bug-fix-queue local state (ledger + queues; may contain PII from real user reports — NEVER commit)
bug-queue/

# healthcheck figure-extraction debug preview (regenerated per extraction run; never commit)
packages/content-neurons-tw/reconcile/healthcheck/figure-preview/

# lofi radio audio (hosted on R2, not committed)
apps/neurons-tw/public/bgm/

# wrangler local state
.wrangler/

# local scratch experiments (not part of the app; audio/video working dirs, large)
music-lab/
brag-output/
