    "verify:normalize": "tsx scripts/verify-normalize.ts",
    "verify:validator": "tsx scripts/verify-validator.ts",
    "verify:dmn": "tsx scripts/verify-dmn-validator.ts",
    "verify:equipment": "tsx scripts/verify-equipment-validator.ts",
    "verify:connectors": "tsx scripts/verify-connectors.ts",
    "verify:option-explanations": "tsx scripts/verify-option-explanations.ts"
